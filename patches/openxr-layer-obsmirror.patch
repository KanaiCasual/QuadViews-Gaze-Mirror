+    void D3D11Mirror::setEyePlacement(uint32_t eye,
+                                      float offsetX,
+                                      float width,
+                                      float height,
+                                      bool scaled,
+                                      const XrCompositionLayerProjectionView* view) {
+        EyePlacement& placement = _eyePlacement[eye];
+        placement.valid = true;
+        // Head orientation and FOV this image was rendered with, to anchor the indicator in the world.
+        placement.fov = view->fov;
+        placement.orientation = view->pose.orientation;
+        placement.offsetX = offsetX;
+        placement.width = width;
+        placement.height = height;
+        // The non-fast-copy paths draw the eye image scaled around its center by the inverse of the FOV ratios.
+        placement.scaleX = (scaled && _fovHorizRatio > 0.f) ? 1.f / _fovHorizRatio : 1.f;
+        placement.scaleY = (scaled && _fovVertRatio > 0.f) ? 1.f / _fovVertRatio : 1.f;
+    }
+
+    // Move a point of the mirror image (pixels) from where it was under the previous frame's head orientation to where
+    // the same world direction shows up under the current one. Only rotation is considered (the point is treated as
+    // infinitely far away), which is what makes the indicator's motion relative to the world instead of the head.
+    bool D3D11Mirror::reprojectToCurrentView(const EyePlacement& placement, float& x, float& y) const {
+        const float tanLeft = tanf(placement.fov.angleLeft);
+        const float tanRight = tanf(placement.fov.angleRight);
+        const float tanDown = tanf(placement.fov.angleDown);
+        const float tanUp = tanf(placement.fov.angleUp);
+        if (placement.width < 1.f || placement.height < 1.f || fabsf(tanRight - tanLeft) < 0.0001f ||
+            fabsf(tanUp - tanDown) < 0.0001f || placement.scaleX <= 0.f || placement.scaleY <= 0.f) {
+            return false;
+        }
+
+        // Pixels -> normalized image coordinates -> view-space direction (-Z is forward, +Y is up).
+        const float u = 0.5f + ((x - placement.offsetX) / placement.width - 0.5f) / placement.scaleX;
+        const float v = 0.5f + (y / placement.height - 0.5f) / placement.scaleY;
+        const XMVECTOR previousDirection =
+            XMVectorSet(tanLeft + (tanRight - tanLeft) * u, tanUp + (tanDown - tanUp) * v, -1.f, 0.f);
+
+        // Previous view -> world -> current view.
+        const XMVECTOR world = XMVector3Rotate(previousDirection, XMLoadFloat4((const XMFLOAT4*)&_gazePrevOrientation));
+        const XMVECTOR current = XMVector3InverseRotate(world, XMLoadFloat4((const XMFLOAT4*)&placement.orientation));
+        const float depth = -XMVectorGetZ(current);
+        if (depth < 0.05f) {
+            // Ended up beside/behind the viewer.
+            return false;
+        }
+
+        const float newU = (XMVectorGetX(current) / depth - tanLeft) / (tanRight - tanLeft);
+        const float newV = (XMVectorGetY(current) / depth - tanUp) / (tanDown - tanUp);
+        x = placement.offsetX + placement.width * (0.5f + (newU - 0.5f) * placement.scaleX);
+        y = placement.height * (0.5f + (newV - 0.5f) * placement.scaleY);
+        return true;
+    }
