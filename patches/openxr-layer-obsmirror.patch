+                                "use_raw_gaze=0\n"
+                                "\n"
+                                "# Where the ring lands. The gaze starts between the eyes, but the mirror shows one eye\n"
+                                "# sitting half an IPD to the side, so the right spot depends on how far away the thing\n"
+                                "# you look at is.\n"
+                                "#   layer    = project the gaze into the mirrored eye here, for focus_distance (exact\n"
+                                "#              per eye, follows the eye selected in OBS)\n"
+                                "#   producer = use Quad-Views-Foveated's own projection (assumes roughly 1 m)\n"
+                                "projection=layer\n"
+                                "# Distance in meters to what you usually look at. 0 = far away (outside the cockpit,\n"
+                                "# HUD symbology). Use about 0.7 if cockpit switches matter more than the outside.\n"
+                                "focus_distance=0\n"
+                                "# Manual trim on top, in fractions of the image height (+X right, +Y up).\n"
+                                "offset_x=0\n"
+                                "offset_y=0\n"
+                                "# Calibration aid: 1 = also show a marker INSIDE the headset where the ring is, so you\n"
+                                "# can centre it on what you look at. It is only switched on and off here (or in the\n"
+                                "# settings app) - never by a key in game. While it is on, Ctrl+Alt+arrow keys nudge the\n"
+                                "# ring (hold Shift for bigger steps) and the nudge is saved into offset_x/offset_y above.\n"
+                                "# Needs OBS to be capturing the mirror. Stare at a fixed target, not at the marker.\n"
+                                "headset_marker=0\n"
+                                "\n"
+                                "# Smoothing of the ring position.\n"
+                                "#   adaptive = steady while the eye is still, instant when it jumps (recommended)\n"
+                                "#   simple   = fixed smoothing, see smoothing_ms\n"
+                                "filter=adaptive\n"
+                                "# adaptive: lower = steadier but laggier ring during fixations (Hz).\n"
+                                "filter_min_cutoff=1.5\n"
+                                "# adaptive: higher = the smoothing lets go sooner as the eye speeds up.\n"
+                                "filter_beta=8\n"
+                                "\n"
+                                "# Dwell feedback: hold the gaze on one spot this long (ms) and the ring tightens and\n"
+                                "# brightens a little, so viewers can tell reading from glancing. 0 = off.\n"
+                                "dwell_ms=500\n"
+                                "# How much the ring tightens while dwelling (fraction of its radius).\n"
+                                "dwell_shrink=0.25\n";
+                }
+            }
+
+            std::error_code ec;
+            const auto writeTime = std::filesystem::last_write_time(_gazeConfigPath, ec);
+            if (ec || writeTime == _gazeConfigTime) {
+                return;
+            }
+            _gazeConfigTime = writeTime;
+
+            GazeConfig config;
+            std::ifstream file(_gazeConfigPath);
+            std::string line;
+            while (std::getline(file, line)) {
+                const auto comment = line.find('#');
+                if (comment != std::string::npos) {
+                    line.erase(comment);
+                }
+                const auto separator = line.find('=');
+                if (separator == std::string::npos) {
+                    continue;
+                }
+                auto trim = [](std::string s) {
+                    const char* blanks = " \t\r\n";
+                    s.erase(0, s.find_first_not_of(blanks));
+                    s.erase(s.find_last_not_of(blanks) + 1);
+                    return s;
+                };
+                const std::string name = trim(line.substr(0, separator));
+                const std::string value = trim(line.substr(separator + 1));
+                try {
+                    if (name == "enabled") {
+                        config.enabled = std::stoi(value) != 0;
+                    } else if (name == "style") {
+                        if (value == "ring") {
+                            config.style = 0;
+                        } else if (value == "glow") {
+                            config.style = 1;
+                        } else if (value == "dot") {
+                            config.style = 2;
+                        } else if (value == "spotlight") {
+                            config.style = 3;
+                        } else if (value == "bubble") {
+                            config.style = 4;
+                        } else if (value == "solid") {
+                            config.style = 5;
+                        } else if (value == "heatmap") {
+                            config.style = 6;
+                        } else if (value == "ghost") {
+                            config.style = 7;
+                        } else {
+                            Log("Gaze overlay: unknown style '%s'\n", value.c_str());
+                        }
+                    } else if (name == "shadow_opacity") {
+                        config.shadowOpacity = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "filter") {
+                        config.adaptiveFilter = value != "simple";
+                    } else if (name == "filter_min_cutoff") {
+                        config.filterMinCutoff = std::clamp(std::stof(value), 0.05f, 60.f);
+                    } else if (name == "filter_beta") {
+                        config.filterBeta = std::clamp(std::stof(value), 0.f, 1000.f);
+                    } else if (name == "dwell_ms") {
+                        config.dwellMs = std::max(std::stof(value), 0.f);
+                    } else if (name == "dwell_shrink") {
+                        config.dwellShrink = std::clamp(std::stof(value), 0.f, 0.9f);
+                    } else if (name == "headset_marker") {
+                        config.headsetMarker = std::stoi(value) != 0;
+                    } else if (name == "projection") {
+                        config.projectRay = value != "producer";
+                    } else if (name == "focus_distance") {
+                        config.focusDistance = std::clamp(std::stof(value), 0.f, 100000.f);
+                    } else if (name == "offset_x") {
+                        config.offsetX = std::clamp(std::stof(value), -1.f, 1.f);
+                    } else if (name == "offset_y") {
+                        config.offsetY = std::clamp(std::stof(value), -1.f, 1.f);
+                    } else if (name == "tail_space") {
+                        config.worldAnchored = value != "screen";
+                    } else if (name == "blend") {
+                        config.screenBlend = value != "normal";
+                    } else if (name == "solidity") {
+                        config.solidity = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "glow_strength") {
+                        config.glowStrength = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "glow") {
+                        config.glowWidth = std::clamp(std::stof(value), 0.0001f, 0.2f);
+                    } else if (name == "tail_opacity") {
+                        config.tailOpacity = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "tail_max") {
+                        config.tailMax = std::clamp(std::stof(value), 0.f, 2.f);
+                    } else if (name == "trail_ms") {
+                        config.trailMs = std::clamp(std::stof(value), 0.f, 10000.f);
+                    } else if (name == "hold_ms") {
+                        config.holdMs = std::max(std::stof(value), 0.f);
+                    } else if (name == "radius") {
+                        config.radius = std::clamp(std::stof(value), 0.001f, 1.f);
+                    } else if (name == "thickness") {
+                        config.thickness = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "feather") {
+                        config.feather = std::clamp(std::stof(value), 0.0005f, 1.f);
+                    } else if (name == "color") {
+                        int r = 255, g = 255, b = 255;
+                        if (sscanf_s(value.c_str(), "%d,%d,%d", &r, &g, &b) == 3) {
+                            config.color[0] = std::clamp(r, 0, 255) / 255.f;
+                            config.color[1] = std::clamp(g, 0, 255) / 255.f;
+                            config.color[2] = std::clamp(b, 0, 255) / 255.f;
+                        }
+                    } else if (name == "opacity") {
+                        config.opacity = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "fill_opacity") {
+                        config.fillOpacity = std::clamp(std::stof(value), 0.f, 1.f);
+                    } else if (name == "smoothing_ms") {
+                        config.smoothingMs = std::max(std::stof(value), 0.f);
+                    } else if (name == "fade_ms") {
+                        config.fadeMs = std::max(std::stof(value), 0.f);
+                    } else if (name == "timeout_ms") {
+                        config.timeoutMs = std::max(std::stof(value), 0.f);
+                    } else if (name == "use_raw_gaze") {
+                        config.useRawGaze = std::stoi(value) != 0;
+                    }
+                } catch (...) {
+                    Log("Gaze overlay: bad value for '%s'\n", name.c_str());
+                }
+            }
+            _gazeConfig = config;
+            Log("Gaze overlay: loaded %s (enabled=%d)\n", _gazeConfigPath.string().c_str(), config.enabled);
+        } catch (...) {
+            // Never let a configuration problem take the game down.
+        }
+    }
+
+    bool D3D11Mirror::createGazeResources() {
+        if (_gazePShader && _gazeConstantBuffer && _gazeBlendState && _gazeScreenBlendState) {
+            return true;
+        }
+        if (_gazeResourcesFailed || !_d3d11MirrorDevice) {
+            return false;
+        }
+        _gazeResourcesFailed = true;
+
+        ComPtr<ID3DBlob> compiled, errors;
+        if (FAILED(D3DCompile(gaze_ps_code,
+                              strlen(gaze_ps_code),
+                              nullptr,
+                              nullptr,
+                              nullptr,
+                              "ps_gaze",
+                              "ps_5_0",
+                              D3DCOMPILE_ENABLE_STRICTNESS | D3DCOMPILE_OPTIMIZATION_LEVEL3,
+                              0,
+                              compiled.GetAddressOf(),
+                              errors.GetAddressOf()))) {
+            Log("Gaze overlay: D3DCompile failed %s\n", errors ? (char*)errors->GetBufferPointer() : "");
+            return false;
+        }
+        if (FAILED(_d3d11MirrorDevice->CreatePixelShader(compiled->GetBufferPointer(),
+                                                         compiled->GetBufferSize(),
+                                                         nullptr,
+                                                         _gazePShader.ReleaseAndGetAddressOf()))) {
+            return false;
+        }
+
+        CD3D11_BUFFER_DESC constantsDesc(
+            sizeof(gaze_buffer_t), D3D11_BIND_CONSTANT_BUFFER, D3D11_USAGE_DYNAMIC, D3D11_CPU_ACCESS_WRITE);
+        if (FAILED(_d3d11MirrorDevice->CreateBuffer(
+                &constantsDesc, nullptr, _gazeConstantBuffer.ReleaseAndGetAddressOf()))) {
+            return false;
+        }
+
+        // Regular alpha blending, but leave the alpha channel of the mirror image untouched.
+        D3D11_BLEND_DESC blendDesc;
+        ZeroMemory(&blendDesc, sizeof(D3D11_BLEND_DESC));
+        blendDesc.RenderTarget[0].BlendEnable = TRUE;
+        blendDesc.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+        blendDesc.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+        blendDesc.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+        blendDesc.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ZERO;
+        blendDesc.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ONE;
+        blendDesc.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+        blendDesc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_RED |
+                                                          D3D11_COLOR_WRITE_ENABLE_GREEN |
+                                                          D3D11_COLOR_WRITE_ENABLE_BLUE;
+        if (FAILED(_d3d11MirrorDevice->CreateBlendState(&blendDesc, _gazeBlendState.ReleaseAndGetAddressOf()))) {
+            return false;
+        }
+
+        // Screen-like blending: src * (1 - dest) + dest * (1 - alpha). With alpha = 0 this is a pure screen blend,
+        // which behaves like light: it never hides the scene behind it and never clips. The shader scales alpha by
+        // the configured solidity to also cover a little of the scene, so the indicator survives bright
+        // backgrounds. Expects premultiplied shader output.
+        blendDesc.RenderTarget[0].SrcBlend = D3D11_BLEND_INV_DEST_COLOR;
+        blendDesc.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+        if (FAILED(_d3d11MirrorDevice->CreateBlendState(&blendDesc, _gazeScreenBlendState.ReleaseAndGetAddressOf()))) {
+            return false;
+        }
+
+        _gazeResourcesFailed = false;
+        return true;
+    }
+
+    void D3D11Mirror::setEyeFovs(const XrFovf& left, const XrFovf& right) {
+        _eyeFov[0] = left;
+        _eyeFov[1] = right;
+        _haveEyeFovs = true;
+    }
+
+    // Calibration nudge keys, polled once per mirrored frame. Calibration itself is only ever switched on and off from
+    // the settings app (headset_marker in the settings file): there is deliberately no in-game key for that, so nothing
+    // pressed during play can put a marker in the headset. While it is off, none of the keys below do anything.
+    // The nudge keys use Ctrl+Alt so they do not collide with the game (plain arrow keys fly the aircraft in DCS), and
+    // GetAsyncKeyState so they work whichever window has focus.
+    void D3D11Mirror::handleCalibrationKeys() {
+        const auto isDown = [](int key) { return (GetAsyncKeyState(key) & 0x8000) != 0; };
+        const bool chord = isDown(VK_CONTROL) && isDown(VK_MENU);
+        const ULONGLONG nowMs = GetTickCount64();
+
+        // Ctrl+Alt+arrows (only while the marker is shown): nudge the trim. One step per press, repeating when held.
+        const int dx = (isDown(VK_RIGHT) ? 1 : 0) - (isDown(VK_LEFT) ? 1 : 0);
+        const int dy = (isDown(VK_UP) ? 1 : 0) - (isDown(VK_DOWN) ? 1 : 0);
+        if (_gazeConfig.headsetMarker && chord && (dx != 0 || dy != 0)) {
+            bool fire = false;
+            if (!_nudgeWasDown) {
+                fire = true;
+                _nudgeNextRepeatMs = nowMs + 400;
+            } else if (nowMs >= _nudgeNextRepeatMs) {
+                fire = true;
+                _nudgeNextRepeatMs = nowMs + 50;
+            }
+            if (fire) {
+                // 0.0005 of the image height is about one pixel on a cropped 1080p stream.
+                const float step = 0.0005f * (isDown(VK_SHIFT) ? 5.f : 1.f);
+                _gazeConfig.offsetX = std::clamp(_gazeConfig.offsetX + dx * step, -0.2f, 0.2f);
+                _gazeConfig.offsetY = std::clamp(_gazeConfig.offsetY + dy * step, -0.2f, 0.2f);
+                _calibrationDirty = true;
+                _calibrationDirtySinceMs = nowMs;
+            }
+            _nudgeWasDown = true;
+        } else {
+            _nudgeWasDown = false;
+        }
+
+        // Save shortly after the last change rather than on every key repeat.
+        if (_calibrationDirty && nowMs - _calibrationDirtySinceMs > 700) {
+            _calibrationDirty = false;
+            persistCalibration();
+        }
+    }
+
+    // Writes the trim back into the settings file, leaving every other line (and its comments) exactly as it is. The
+    // marker switch is NOT written: only the settings app owns it, so a nudge can never switch calibration back on after
+    // the user switched it off there.
+    void D3D11Mirror::persistCalibration() {
+        try {
+            if (_gazeConfigPath.empty()) {
+                return;
+            }
+            std::string text;
+            {
+                std::ifstream in(_gazeConfigPath, std::ios::binary);
+                std::stringstream buffer;
+                buffer << in.rdbuf();
+                text = buffer.str();
+            }
+
+            const auto setKey = [&text](const std::string& key, const std::string& value) {
+                size_t pos = 0;
+                while (pos < text.size()) {
+                    size_t lineEnd = text.find('\n', pos);
+                    if (lineEnd == std::string::npos) {
+                        lineEnd = text.size();
+                    }
+                    const size_t first = text.find_first_not_of(" \t", pos);
+                    if (first != std::string::npos && first < lineEnd && text.compare(first, key.size() + 1, key + "=") == 0) {
+                        const bool carriageReturn = lineEnd > pos && text[lineEnd - 1] == '\r';
+                        text.replace(pos, lineEnd - pos, key + "=" + value + (carriageReturn ? "\r" : ""));
+                        return;
+                    }
+                    pos = lineEnd + 1;
+                }
+                if (!text.empty() && text.back() != '\n') {
+                    text += "\n";
+                }
+                text += key + "=" + value + "\n";
+            };
+
+            char number[32];
+            snprintf(number, sizeof(number), "%.4f", _gazeConfig.offsetX);
+            setKey("offset_x", number);
+            snprintf(number, sizeof(number), "%.4f", _gazeConfig.offsetY);
+            setKey("offset_y", number);
+
+            // Write-then-swap, so nothing ever reads a half-written file.
+            auto temp = _gazeConfigPath;
+            temp += ".tmp";
+            {
+                std::ofstream out(temp, std::ios::binary | std::ios::trunc);
+                out << text;
+            }
+            std::filesystem::rename(temp, _gazeConfigPath);
+
+            // We already hold these values: no need to reload our own write.
+            std::error_code ec;
+            _gazeConfigTime = std::filesystem::last_write_time(_gazeConfigPath, ec);
+            Log("Gaze overlay: saved trim %.4f, %.4f\n", _gazeConfig.offsetX, _gazeConfig.offsetY);
+        } catch (...) {
+            // Never let a settings problem take the game down.
+        }
+    }
+
+    void D3D11Mirror::drawGazeOverlay() {
+        loadGazeConfig();
+        handleCalibrationKeys();
+        if (!_gazeConfig.headsetMarker && _markerPublished) {
+            // Switched off: tell the producer right away instead of letting the marker time out.
+            const float none[2][2]{};
+            const float black[3]{};
+            _markerWriter.publish(false, none, 0.f, black);
+            _markerPublished = false;
+        }
+        if (!_gazeConfig.enabled || !_compositorTexture || !_targetView) {
+            return;
+        }
+
+        // The gaze producer (Quad-Views-Foveated) might not be present, or might show up later.
+        if (_gazeReaderRetryCountdown > 0) {
+            _gazeReaderRetryCountdown--;
+            return;
+        }
+        if (!_gazeReader.open()) {
+            _gazeReaderRetryCountdown = 90;
+            return;
+        }
+
+        const auto now = std::chrono::steady_clock::now();
+        float dtMs = 0.f;
+        if (_gazeLastDraw.time_since_epoch().count() != 0) {
+            dtMs = std::chrono::duration<float, std::milli>(now - _gazeLastDraw).count();
+        }
+        _gazeLastDraw = now;
+        dtMs = std::clamp(dtMs, 0.f, 100.f);
+
+        // Find where the gaze lands in the mirror image.
+        bool haveTarget = false;
+        float target[2] = {0.f, 0.f};
+        eye_gaze_export::SharedData data{};
+        if (_gazeReader.read(data) && data.isGazeValid &&
+            static_cast<float>(GetTickCount64() - data.updateTickMs) <= _gazeConfig.timeoutMs) {
+            const auto& gaze = _gazeConfig.useRawGaze ? data.rawGaze : data.gaze;
+            // Where the gaze lands in an eye's full image, as 0..1 coordinates from the top-left corner.
+            auto imageCoords = [&](uint32_t eye, const XrFovf& fov, float& u, float& v) {
+                // Fallback: the position projected by the producer (which assumes a fixed fixation distance).
+                u = (gaze[eye][0] + 1.f) / 2.f;
+                v = (1.f - gaze[eye][1]) / 2.f;
+
+                if (_gazeConfig.projectRay && data.hasGazeRay) {
+                    // Project the gaze ray into this eye's camera ourselves. The ray starts between the eyes but the
+                    // mirror shows a single eye sitting ~half an IPD to the side, so where the ray lands in the image
+                    // depends on how far away the fixated object is.
+                    const XMVECTOR direction =
+                        XMVectorSet(data.gazeDirection[0], data.gazeDirection[1], data.gazeDirection[2], 0.f);
+                    const XMVECTOR eyePosition =
+                        XMVectorSet(data.eyePosition[eye][0], data.eyePosition[eye][1], data.eyePosition[eye][2], 0.f);
+                    const XMVECTOR eyeOrientation = XMVectorSet(data.eyeOrientation[eye][0],
+                                                                data.eyeOrientation[eye][1],
+                                                                data.eyeOrientation[eye][2],
+                                                                data.eyeOrientation[eye][3]);
+                    // focus_distance <= 0 means "far away": only the direction matters.
+                    const XMVECTOR fromEye =
+                        _gazeConfig.focusDistance > 0.f
+                            ? XMVectorSubtract(XMVectorScale(direction, _gazeConfig.focusDistance), eyePosition)
+                            : direction;
+                    const XMVECTOR inEye = XMVector3InverseRotate(fromEye, XMQuaternionNormalize(eyeOrientation));
+                    const float depth = -XMVectorGetZ(inEye);
+
+                    const float tanLeft = tanf(fov.angleLeft);
+                    const float tanRight = tanf(fov.angleRight);
+                    const float tanDown = tanf(fov.angleDown);
+                    const float tanUp = tanf(fov.angleUp);
+                    if (depth > 0.0001f && fabsf(tanRight - tanLeft) > 0.0001f && fabsf(tanUp - tanDown) > 0.0001f) {
+                        const float rayU = (XMVectorGetX(inEye) / depth - tanLeft) / (tanRight - tanLeft);
+                        const float rayV = (XMVectorGetY(inEye) / depth - tanUp) / (tanDown - tanUp);
+                        // Never let bad data (eg: an all-zero orientation) poison the smoothed position.
+                        if (std::isfinite(rayU) && std::isfinite(rayV)) {
+                            u = rayU;
+                            v = rayV;
+                        }
+                    }
+                }
+            };
+
+            auto project = [&](uint32_t eye, float& x, float& y) {
+                const EyePlacement& placement = _eyePlacement[eye];
+                float u, v;
+                imageCoords(eye, placement.fov, u, v);
+                x = placement.offsetX + placement.width * (0.5f + (u - 0.5f) * placement.scaleX);
+                y = placement.height * (0.5f + (v - 0.5f) * placement.scaleY);
+                // Manual trim, in fractions of the image height (+X right, +Y up).
+                x += _gazeConfig.offsetX * placement.height;
+                y -= _gazeConfig.offsetY * placement.height;
+            };
+
+            // Calibration aid: ask the producer to show a marker inside the headset where the ring is, for both eyes,
+            // using exactly the placement above (including the trim the user is adjusting).
+            if (_gazeConfig.headsetMarker && _haveEyeFovs) {
+                float position[2][2];
+                for (uint32_t eye = 0; eye < 2; eye++) {
+                    const XrFovf& fov = _eyeFov[eye];
+                    float u, v;
+                    imageCoords(eye, fov, u, v);
+                    // The trim is a fraction of the image HEIGHT in both directions; convert it for this eye's aspect.
+                    const float aspect = fabsf(tanf(fov.angleUp) - tanf(fov.angleDown)) /
+                                         std::max(fabsf(tanf(fov.angleRight) - tanf(fov.angleLeft)), 0.0001f);
+                    position[eye][0] = (u + _gazeConfig.offsetX * aspect) * 2.f - 1.f;
+                    position[eye][1] = 1.f - (v - _gazeConfig.offsetY) * 2.f;
+                }
+                const float linearColor[3] = {
+                    powf(_gazeConfig.color[0], 2.2f), powf(_gazeConfig.color[1], 2.2f), powf(_gazeConfig.color[2], 2.2f)};
+                _markerWriter.publish(true, position, _gazeConfig.radius, linearColor);
+                _markerPublished = true;
+            }
+
+            if (_eyePlacement[0].valid && _eyePlacement[1].valid) {
+                // Both eyes stitched together: the left eye is visible left of the blend line, the right eye right
+                // of it. Follow whichever eye's image is actually shown where the user is looking.
+                float left[2], right[2];
+                project(0, left[0], left[1]);
+                project(1, right[0], right[1]);
+                const EyePlacement& rightEye = _eyePlacement[1];
+                const float blendCenter = rightEye.offsetX + rightEye.width * _pMirrorSurfaceData->blendPos / 100.f;
+                const float blendHalfWidth = std::max(rightEye.width * _pMirrorSurfaceData->blend / 200.f, 1.f);
+                const float average = (left[0] + right[0]) / 2.f;
+                float weight = std::clamp((average - (blendCenter - blendHalfWidth)) / (2.f * blendHalfWidth), 0.f, 1.f);
+                weight = weight * weight * (3.f - 2.f * weight);
+                target[0] = left[0] + (right[0] - left[0]) * weight;
+                target[1] = left[1] + (right[1] - left[1]) * weight;
+                haveTarget = true;
+            } else if (_eyePlacement[0].valid || _eyePlacement[1].valid) {
+                project(_eyePlacement[0].valid ? 0 : 1, target[0], target[1]);
