+    // Eye gaze indicator: a soft ring (with an optional faint fill) drawn over the whole mirror image.
+    struct gaze_buffer_t {
+        float center[2];   // UV space.
+        float aspect[2];   // Scales UV deltas into "fraction of image height" units.
+        float radius;
+        float thickness;
+        float feather;
+        float fillOpacity;
+        float color[4];    // rgb + opacity.
+        float style;       // 0 = ring, 1 = glow, 2 = dot, 3 = spotlight, 4 = bubble, 5 = solid, 6 = heatmap, 7 = ghost.
+        float shadowOpacity;
+        float trailCount;
+        float heatGain;
+        float glowWidth;
+        float tailOpacity;
+        float premultiply; // 1 = output premultiplied color (screen blending).
+        float solidity;    // Screen blending: how much the indicator also covers what is behind it.
+        float glowStrength; // ghost: brightness of the glow hugging the ring, relative to the ring.
+        float padding[3];
+        float trail[32][4]; // xy = position (UV), z = weight. For ghost, trail[1] is the tip of the tail.
+    };
+
+    constexpr char gaze_ps_code[] = R"_(
+
+cbuffer GazeConstants : register(b1)
+{
+    float2 center;
+    float2 aspect;
+    float radius;
+    float thickness;
+    float feather;
+    float fillOpacity;
+    float4 color;
+    float style;
+    float shadowOpacity;
+    float trailCount;
+    float heatGain;
+    float glowWidth;
+    float tailOpacity;
+    float premultiply;
+    float solidity;
+    float glowStrength;
+    float3 padding;
+    float4 trail[32]; // xy = position (UV), z = weight (1 = current gaze, fading to 0 with age).
+};
+
+// Signed distance to a capsule whose radius tapers from ra (at the origin) to rb (at pb).
+float sdTaperedCapsule(float2 p, float2 pb, float ra, float rb)
+{
+    float h = dot(pb, pb);
+    float2 q = float2(dot(p, float2(pb.y, -pb.x)), dot(p, pb)) / h;
+    q.x = abs(q.x);
+    float b = ra - rb;
+    float2 c = float2(sqrt(max(h - b * b, 0.0)), b);
+    float k = c.x * q.y - c.y * q.x;
+    float m = dot(c, q);
+    float n = dot(q, q);
+    if (k < 0.0) {
+        return sqrt(h * n) - ra;
+    } else if (k > c.x) {
+        return sqrt(h * (n + 1.0 - 2.0 * q.y)) - rb;
+    }
+    return m - ra;
+}
+
+// Tobii Ghost look: a thin neon ring with a clear center, dragging a glowing teardrop tail that stretches with
+// eye movement and collapses back into the ring during fixations.
+float4 ghost(float2 uv)
+{
+    float2 p = (uv - center) * aspect;
+    float2 tip = (trail[1].xy - center) * aspect;
+    float tipRadius = radius * 0.03;
+    float tailLength = length(tip);
+    float glowReach = max(glowWidth, 0.0001);
+
+    // Local frame: `a` runs from the ring towards the tail, `b` across it.
+    float2 tailDir = tailLength > 0.00001 ? tip / tailLength : float2(1.0, 0.0);
+    float a = dot(p, tailDir);
+    float b = dot(p, float2(-tailDir.y, tailDir.x));
+
+    // The ring deforms with speed: it is pulled out towards the tail, flattens a little at the front and gets
+    // narrower, so that ring and tail read as one teardrop instead of a circle sitting on a cone.
+    float deform = saturate(tailLength / (2.5 * radius));
+    float squash = 1.0 - 0.12 * deform;
+    float2 q = float2(a > 0.0 ? a / (1.0 + 0.35 * deform) : a / (1.0 - 0.08 * deform), b / squash);
+    float dHead = length(q) - radius;
+
+    float dDrop = dHead;
+    float along = 0.0;
+    float stretch = 0.0;
+    float headRadius = radius * squash;
+    if (tailLength > headRadius - tipRadius + 0.0005) {
+        // Smooth union, so the tail grows out of the head without a crease.
+        float dTail = sdTaperedCapsule(p, tip, headRadius, tipRadius);
+        float k = radius * 0.35;
+        float h = saturate(0.5 + 0.5 * (dTail - dHead) / k);
+        dDrop = lerp(dTail, dHead, h) - k * h * (1.0 - h);
+        // 0 where the tail leaves the rear of the ring, 1 at the tip.
+        along = saturate((a - radius) / max(tailLength - radius, 0.0001));
+        // Ease the tail in as it emerges from the ring, so it does not pop.
+        stretch = saturate((tailLength - radius) / radius);
+    }
+
+    // The crisp stroke only survives on the leading side; towards the tail it dissolves into the trail.
+    float facing = -a / max(length(p), 0.00001); // +1 at the front of the movement, -1 at the tail side.
+    float dissolve = saturate((tailLength - 0.5 * radius) / (1.5 * radius));
+    float stroke = lerp(1.0, smoothstep(-0.8, 0.45, facing), dissolve);
+
+    float halfThickness = thickness * 0.5;
+    // The fade straddles the edge of the line (half inwards, half outwards), so softening the edge never changes how
+    // wide the line looks: 	hickness alone is the apparent width. It cannot be softer than the line is wide.
+    float edgeSoftness = max(min(feather, thickness) * 0.5, 0.00002);
+    float ring = (1.0 - smoothstep(halfThickness - edgeSoftness, halfThickness + edgeSoftness, abs(dHead))) * stroke;
+    float ringGlow = exp(-abs(dHead) / glowReach) * stroke;
+
+    // The tail has no hard outline: soft edges, brightest where it leaves the ring, fading out to the tip.
+    float outsideHead = smoothstep(-halfThickness, halfThickness, dHead);
+    float behind = smoothstep(-0.35, 0.45, -facing); // The tail and its haze stay behind the ring.
+    float tailFade = pow(1.0 - along, 0.8) * stretch * outsideHead * behind;
+    float tailSoft = max(glowReach, 0.006); // Keep the tail soft even with a tight ring glow.
+    float tailBody = (1.0 - smoothstep(-tailSoft, tailSoft * 0.5, dDrop)) * tailFade * tailOpacity;
+    float tailGlow = exp(-max(dDrop, 0.0) / tailSoft) * tailFade;
+
+    float inside = (1.0 - smoothstep(-feather, feather, dHead)) * fillOpacity;
+    float alpha = max(max(ring, tailBody) * color.a, max(ringGlow * glowStrength, tailGlow * 0.35) * color.a);
+    return float4(color.rgb, max(alpha, inside));
+}
+
+// Tobii Ghost-like blob: the head is either a "bubble" (faint center, brighter soft rim) or a solid soft disc, and
+// it drags a tail of shrinking, fading discs behind it.
+float blobWithTrail(float2 uv, bool bubble)
+{
+    float result = 0.0;
+    int count = (int)trailCount;
+    [loop] for (int i = 0; i < 32; i++) {
+        if (i >= count) {
+            break;
+        }
+        float w = trail[i].z;
+        float r = radius * (0.35 + 0.65 * w);
+        float d = length((uv - trail[i].xy) * aspect);
+        float outer = 1.0 - smoothstep(r, r + feather, d);
+        float inner = color.a;
+        if (bubble) {
+            float t = saturate(d / r);
+            // Only the head gets the bubble profile; older rims showing through it would look like an onion.
+            inner = (i == 0) ? lerp(fillOpacity, color.a, t * t * t) : lerp(fillOpacity, color.a, 0.35);
+        }
+        result = max(result, inner * outer * w * w);
+    }
+    return result;
+}
+
+// Dwell-time heatmap along the trail: blue (glanced at) -> green -> yellow -> red (stared at).
+float4 heatmap(float2 uv)
+{
+    float heat = 0.0;
+    int count = (int)trailCount;
+    [loop] for (int i = 0; i < 32; i++) {
+        if (i >= count) {
+            break;
+        }
+        float x = length((uv - trail[i].xy) * aspect) / max(radius, 0.0001);
+        heat += trail[i].z * exp(-2.0 * x * x);
+    }
+    heat = saturate(heat * heatGain);
+
+    float3 cold = float3(0.0, 0.25, 1.0);
+    float3 mild = float3(0.0, 1.0, 0.3);
+    float3 warm = float3(1.0, 0.85, 0.0);
+    float3 hot = float3(1.0, 0.08, 0.0);
+    float3 rgb = heat < 0.33 ? lerp(cold, mild, heat / 0.33)
+               : heat < 0.66 ? lerp(mild, warm, (heat - 0.33) / 0.33)
+                             : lerp(warm, hot, (heat - 0.66) / 0.34);
+    return float4(rgb, color.a * smoothstep(0.03, 0.3, heat));
+}
+
+struct psIn {
+	float4 pos : SV_POSITION;
+	float2 tex : TEXCOORD0;
+};
+
+// Composite the indicator (color.rgb, fg) over a black outline (shadow) into a single premultiplied-free output.
+float4 withShadow(float fg, float shadow)
+{
+    float alpha = fg + shadow * (1.0 - fg);
+    return float4(color.rgb * (fg / max(alpha, 0.0001)), alpha);
+}
+
+float4 shade(psIn inputPS)
+{
+    float dist = length((inputPS.tex - center) * aspect);
+    float shadowWidth = feather * 3.0 + 0.0015;
+
+    if (style < 0.5) {
+        // Ring.
+        float halfThickness = thickness * 0.5;
+        float edge = abs(dist - radius);
+        float edgeSoftness = max(min(feather, thickness) * 0.5, 0.00002);
+        float ring = 1.0 - smoothstep(halfThickness - edgeSoftness, halfThickness + edgeSoftness, edge);
+        float disc = 1.0 - smoothstep(radius, radius + feather, dist);
+        float shadow = 1.0 - smoothstep(halfThickness, halfThickness + edgeSoftness + shadowWidth, edge);
+        return withShadow(max(ring * color.a, disc * fillOpacity), shadow * shadowOpacity);
+    } else if (style < 1.5) {
+        // Glow: borderless gaussian highlight.
+        float x = dist / max(radius, 0.0001);
+        return float4(color.rgb, color.a * exp(-2.0 * x * x));
+    } else if (style < 2.5) {
+        // Dot.
+        float core = 1.0 - smoothstep(radius, radius + feather, dist);
+        float shadow = 1.0 - smoothstep(radius, radius + feather + shadowWidth, dist);
+        return withShadow(core * color.a, shadow * shadowOpacity);
+    } else if (style > 3.5 && style < 4.5) {
+        return float4(color.rgb, blobWithTrail(inputPS.tex, true));
+    } else if (style > 4.5 && style < 5.5) {
+        return float4(color.rgb, blobWithTrail(inputPS.tex, false));
+    } else if (style > 5.5 && style < 6.5) {
+        return heatmap(inputPS.tex);
+    } else if (style > 6.5) {
+        return ghost(inputPS.tex);
+    }
+
+    // Spotlight: darken everything but the gaze area.
+    float outside = smoothstep(radius, radius + max(feather, radius), dist);
+    return float4(0.0, 0.0, 0.0, color.a * outside);
+}
+
+float4 ps_gaze(psIn inputPS) : SV_TARGET
+{
+    float4 result = shade(inputPS);
+    if (premultiply > 0.5) {
+        // Screen-like blending (src * (1 - dest) + dest * (1 - alpha)) expects the color already scaled by its
+        // coverage. The alpha that is left only decides how much of the scene behind gets covered.
+        result.rgb *= result.a;
+        result.a *= solidity;
+    }
+    return result;
+}
