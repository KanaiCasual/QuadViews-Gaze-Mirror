+++ b/openxr-api-layer/eye_gaze_export.h
@@ -0,0 +1,316 @@
+// MIT License
+//
+// Shared-memory export of the projected eye gaze, so that other in-process API layers or external tools (eg: an OBS
+// mirror) can visualize where the user is looking.
+//
+// This file is shared verbatim between the producer (Quad-Views-Foveated) and consumers (eg: OBSMirror).
+
+#pragma once
+
+#include <windows.h>
+#include <cstdint>
+#include <cstring>
+
+namespace eye_gaze_export {
+
+    constexpr wchar_t SharedMemoryName[] = L"QuadViewsFoveated.EyeGaze";
+    constexpr uint32_t Magic = 0x47455651; // 'QVEG'
+    constexpr uint32_t Version = 2;
+
+    struct SharedData {
+        uint32_t magic;
+        uint32_t version;
+
+        // Seqlock: odd while the writer is updating the fields below.
+        volatile LONG sequence;
+
+        // Whether the eye tracker reported a valid gaze for the last update.
+        uint32_t isGazeValid;
+
+        // GetTickCount64() of the last update.
+        uint64_t updateTickMs;
+
+        // Gaze projected into each eye's full FOV, in normalized device coordinates (-1..+1, +Y up).
+        // [eye][0] = x, [eye][1] = y. Eye 0 = left, eye 1 = right.
+        // `gaze` includes the user's focus offsets (center of the focus view), `rawGaze` does not.
+        float gaze[2][2];
+        float rawGaze[2][2];
+
+        // --- Version 2 and up (appended, so version 1 readers keep working) ---
+
+        // The gaze ray and the eye cameras, so that a consumer can do its own (distance-aware) projection instead of
+        // relying on the fixed-distance projection baked into `gaze`/`rawGaze`. Everything is in VIEW space (origin
+        // between the eyes, +X right, +Y up, -Z forward).
+        uint32_t hasGazeRay;
+        float gazeDirection[3];     // Unit vector.
+        float eyePosition[2][3];    // [eye][x,y,z], eye 0 = left, eye 1 = right.
+        float eyeOrientation[2][4]; // [eye][x,y,z,w] quaternion (not identity on headsets with canted displays).
+    };
+
+    class Writer {
+      public:
+        ~Writer() {
+            if (m_data) {
+                UnmapViewOfFile(m_data);
+            }
+            if (m_mapping) {
+                CloseHandle(m_mapping);
+            }
+        }
+
+        bool open() {
+            if (m_data) {
+                return true;
+            }
+            m_mapping = CreateFileMappingW(
+                INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(SharedData), SharedMemoryName);
+            if (!m_mapping) {
+                return false;
+            }
+            m_data = static_cast<SharedData*>(MapViewOfFile(m_mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(SharedData)));
+            if (!m_data) {
+                CloseHandle(m_mapping);
+                m_mapping = nullptr;
+                return false;
+            }
+            m_data->magic = Magic;
+            m_data->version = Version;
+            return true;
+        }
+
+        void publish(bool isGazeValid,
+                     const float gaze[2][2],
+                     const float rawGaze[2][2],
+                     const float gazeDirection[3],
+                     const float eyePosition[2][3],
+                     const float eyeOrientation[2][4]) {
+            if (!m_data) {
+                return;
+            }
+            InterlockedIncrement(&m_data->sequence);
+            m_data->isGazeValid = isGazeValid;
+            m_data->updateTickMs = GetTickCount64();
+            if (isGazeValid) {
+                memcpy(m_data->gaze, gaze, sizeof(m_data->gaze));
+                memcpy(m_data->rawGaze, rawGaze, sizeof(m_data->rawGaze));
+                memcpy(m_data->gazeDirection, gazeDirection, sizeof(m_data->gazeDirection));
+                memcpy(m_data->eyePosition, eyePosition, sizeof(m_data->eyePosition));
+                memcpy(m_data->eyeOrientation, eyeOrientation, sizeof(m_data->eyeOrientation));
+                m_data->hasGazeRay = 1;
+            }
+            InterlockedIncrement(&m_data->sequence);
+        }
+
+      private:
+        HANDLE m_mapping{nullptr};
+        SharedData* m_data{nullptr};
+    };
+
+    class Reader {
+      public:
+        ~Reader() {
+            if (m_data) {
+                UnmapViewOfFile(m_data);
+            }
+            if (m_mapping) {
+                CloseHandle(m_mapping);
+            }
+        }
+
+        // Cheap to call repeatedly: the producer might not exist (yet).
+        bool open() {
+            if (m_data) {
+                return true;
+            }
+            m_mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, SharedMemoryName);
+            if (!m_mapping) {
+                return false;
+            }
+            m_data = static_cast<const SharedData*>(MapViewOfFile(m_mapping, FILE_MAP_READ, 0, 0, sizeof(SharedData)));
+            if (!m_data) {
+                CloseHandle(m_mapping);
+                m_mapping = nullptr;
+                return false;
+            }
+            return true;
+        }
+
+        // Returns false if no consistent snapshot could be read.
+        bool read(SharedData& snapshot) const {
+            if (!m_data || m_data->magic != Magic || m_data->version < 1) {
+                return false;
+            }
+            for (int attempt = 0; attempt < 4; attempt++) {
+                const LONG before = m_data->sequence;
+                if (before & 1) {
+                    continue;
+                }
+                memcpy(&snapshot, m_data, sizeof(snapshot));
+                if (m_data->sequence == before) {
+                    if (snapshot.version < 2) {
+                        // Older producer: the fields past `rawGaze` were never written.
+                        snapshot.hasGazeRay = 0;
+                    }
+                    return true;
+                }
+            }
+            return false;
+        }
+
+      private:
+        HANDLE m_mapping{nullptr};
+        const SharedData* m_data{nullptr};
+    };
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // Reverse channel: a consumer that draws a gaze indicator somewhere only it can see (eg: an OBS mirror) asks the
+    // producer - the one layer that can safely draw into the frames sent to the headset - to show a simple marker at the
+    // same spot, so the user can line the indicator up with what they are looking at from inside the headset.
+    // ---------------------------------------------------------------------------------------------------------------
+
+    constexpr wchar_t MarkerSharedMemoryName[] = L"QuadViewsFoveated.HeadsetMarker";
+    constexpr uint32_t MarkerMagic = 0x4D485651; // 'QVHM'
+    constexpr uint32_t MarkerVersion = 1;
+
+    struct MarkerData {
+        uint32_t magic;
+        uint32_t version;
+
+        // Seqlock: odd while the writer is updating the fields below.
+        volatile LONG sequence;
+
+        // Whether the marker should be drawn at all.
+        uint32_t enabled;
+
+        // GetTickCount64() of the last update. The producer stops drawing when this goes stale.
+        uint64_t updateTickMs;
+
+        // Where to draw, per eye, in that eye's full-FOV normalized device coordinates (-1..+1, +Y up).
+        float position[2][2];
+
+        // Half-size of the marker, as a fraction of the image height.
+        float size;
+
+        // Linear RGB, 0..1.
+        float color[3];
+    };
+
+    // How a side attaches to a named shared-memory block.
+    //   Create    - the side that is always running makes the block once, up front. That way nobody ever has to keep
+    //               looking for a block that might appear later: the other side just opens it when it has something to say.
+    //   OpenRead / OpenWrite - attach to a block somebody else created.
+    enum class BlockAccess { Create, OpenRead, OpenWrite };
+
+    // Owns a named shared-memory block of type T.
+    template <typename T>
+    class SharedBlock {
+      public:
+        ~SharedBlock() {
+            if (m_data) {
+                UnmapViewOfFile(m_data);
+            }
+            if (m_mapping) {
+                CloseHandle(m_mapping);
+            }
+        }
+
+        bool open(const wchar_t* name, BlockAccess access) {
+            if (m_data) {
+                return true;
+            }
+            m_mapping = access == BlockAccess::Create
+                            ? CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(T), name)
+                            : OpenFileMappingW(access == BlockAccess::OpenWrite ? FILE_MAP_ALL_ACCESS : FILE_MAP_READ, FALSE, name);
+            if (!m_mapping) {
+                return false;
+            }
+            m_data = static_cast<T*>(MapViewOfFile(
+                m_mapping, access == BlockAccess::OpenRead ? FILE_MAP_READ : FILE_MAP_ALL_ACCESS, 0, 0, sizeof(T)));
+            if (!m_data) {
+                CloseHandle(m_mapping);
+                m_mapping = nullptr;
+                return false;
+            }
+            return true;
+        }
+
+        T* data() const {
+            return m_data;
+        }
+
+      private:
+        HANDLE m_mapping{nullptr};
+        T* m_data{nullptr};
+    };
+
+    // The consumer's side: only attaches while it actually has a marker to show (calibration), which is rare.
+    class MarkerWriter {
+      public:
+        void publish(bool enabled, const float position[2][2], float size, const float color[3]) {
+            if (!m_block.open(MarkerSharedMemoryName, BlockAccess::OpenWrite)) {
+                return;
+            }
+            MarkerData* data = m_block.data();
+            InterlockedIncrement(&data->sequence);
+            data->enabled = enabled;
+            data->updateTickMs = GetTickCount64();
+            memcpy(data->position, position, sizeof(data->position));
+            data->size = size;
+            memcpy(data->color, color, sizeof(data->color));
+            InterlockedIncrement(&data->sequence);
+        }
+
+      private:
+        SharedBlock<MarkerData> m_block;
+    };
+
+    // The producer's side. It creates the block once, so that checking for a marker is a plain memory read every frame
+    // instead of a periodic search for a block that almost never exists.
+    class MarkerReader {
+      public:
+        void create() {
+            if (m_block.open(MarkerSharedMemoryName, BlockAccess::Create)) {
+                m_block.data()->magic = MarkerMagic;
+                m_block.data()->version = MarkerVersion;
+            }
+        }
+
+        // Returns false when there is no marker to draw (disabled - the normal case - stale, or mid-update).
+        bool read(MarkerData& snapshot) const {
+            const MarkerData* data = m_block.data();
+            if (!data || !data->enabled) {
+                return false;
+            }
+            for (int attempt = 0; attempt < 4; attempt++) {
+                const LONG before = data->sequence;
+                if (before & 1) {
+                    continue;
+                }
+                memcpy(&snapshot, data, sizeof(snapshot));
+                if (data->sequence == before) {
+                    return snapshot.enabled && GetTickCount64() - snapshot.updateTickMs < 500;
+                }
+            }
+            return false;
+        }
+
+      private:
+        SharedBlock<MarkerData> m_block;
+    };
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // "Settings changed" signal. The consumer never polls its settings file: it creates this block once and compares
+    // `generation` with the last value it saw (a memory read). Whoever edits the settings - the settings app - bumps it.
+    // With no editor running nothing ever changes it, so nothing is ever re-read.
+    // ---------------------------------------------------------------------------------------------------------------
+
+    constexpr wchar_t SettingsSignalName[] = L"GazeOverlay.SettingsSignal";
+    constexpr uint32_t SettingsSignalMagic = 0x53534F47; // 'GOSS'
+
+    struct SettingsSignal {
+        uint32_t magic;
+        uint32_t version;
+        volatile LONG generation;
+    };
+
+} // namespace eye_gaze_export
