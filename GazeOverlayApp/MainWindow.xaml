<Window x:Class="GazeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenXR Gaze Overlay" Width="1120" Height="820" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontSize="13" UseLayoutRounding="True"
        Background="{StaticResource WindowBack}" Icon="Assets/icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shown when a newer release exists. It only links to the release page; nothing is downloaded by the app. -->
        <Border x:Name="UpdateBanner" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="10,10,10,0" Padding="14,10"
                Background="#16283A" BorderBrush="#2F6FA8" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateDetail" Style="{StaticResource Hint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="View release" FontWeight="SemiBold" Margin="12,0,8,0" Click="OnViewUpdate" />
                    <Button Content="Skip this version" Margin="0,0,8,0" Click="OnSkipUpdate" />
                    <Button Content="Later" Click="OnDismissUpdate" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Grid.Column="0" Margin="10,10,0,10" Padding="0">
            <TabItem Header="Status" Padding="14,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Status" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="Shows viewers where you are looking in VR: a ring drawn on your OBS mirror only, never in the headset. This app edits the ring's settings and, on the Quad Views tab, Quad-Views-Foveated's. Installing, updating and removing is done by the OpenXR Gaze Overlay installer (.msi) and Windows' installed-apps list." />

                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,4">
                            <StackPanel x:Name="StatusRows" />
                        </Border>
                        <Button Content="Refresh" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRefresh" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Live check" Margin="0,22,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="10" Height="10" Margin="0,4,8,0" VerticalAlignment="Top" Fill="Gray" />
                            <TextBlock x:Name="LiveText" TextWrapping="Wrap" MaxWidth="600" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="OpenXR layer order" Margin="0,22,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Top is closest to the game. Quad-Views-Foveated must be above OBS Mirror." />
                        <TextBlock x:Name="LayerList" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="In OBS" Margin="0,22,0,4" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Add an &quot;OpenXR Mirror Capture&quot; source to your scene and pick the eye to record. The ring follows that eye automatically and only appears while your game is running with eye tracking active." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Look" Padding="14,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelLook" Margin="20,16,20,20" /></ScrollViewer></TabItem>
            <TabItem Header="Tail" Padding="14,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelTail" Margin="20,16,20,20" /></ScrollViewer></TabItem>
            <TabItem Header="Motion" Padding="14,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelMotion" Margin="20,16,20,20" /></ScrollViewer></TabItem>
            <TabItem Header="Placement" Padding="14,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelPlacement" Margin="20,16,20,20" /></ScrollViewer></TabItem>

            <TabItem x:Name="QuadViewsTab" Header="Quad Views" Padding="14,6">
                <DockPanel>
                    <!-- Stays in view while the sliders scroll: what the settings cost, and the Apply button. -->
                    <Border DockPanel.Dock="Top" Margin="20,16,20,0" Padding="14,10" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Render load" />
                            <TextBlock x:Name="QuadViewsLoadLast" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="QuadViewsLoadSaved" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="QuadViewsLoadNext" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,0"
                                       Text="Pixels are a guide to GPU load, not a frame-rate prediction: a game that is waiting on the CPU will not speed up." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="QuadViewsApply" Content="Apply" FontWeight="SemiBold" MinWidth="90" Margin="0,0,8,0" Click="OnQuadViewsApply" />
                                <Button x:Name="QuadViewsRevert" Content="Revert" Margin="0,0,8,0" Click="OnQuadViewsRevert" />
                                <Button Content="Open settings file" Margin="0,0,8,0" Click="OnQuadViewsOpenFile" />
                                <Button Content="Open log" Click="OnQuadViewsOpenLog" />
                            </StackPanel>
                            <TextBlock x:Name="QuadViewsStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuadViewsNotice" DockPanel.Dock="Top" Margin="20,10,20,0" Padding="14,10"
                            Background="#33270F" BorderBrush="#A8741F" BorderThickness="1" CornerRadius="6">
                        <TextBlock x:Name="QuadViewsNoticeText" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelQuadViews" Margin="20,16,20,20" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="About" Padding="14,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="About" />
                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" Margin="0,6,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="The app can look at the project's GitHub releases when it opens and tell you when a newer version exists. It only reads that public list - it never downloads or installs anything. You get a link to the release page and install the new .msi yourself." />
                        <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates when the app opens" Checked="OnUpdatePreferenceChanged" Unchecked="OnUpdatePreferenceChanged" />
                        <CheckBox x:Name="IncludeBetasBox" Content="Also tell me about beta versions" Margin="0,4,0,0" Checked="OnUpdatePreferenceChanged" Unchecked="OnUpdatePreferenceChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CheckNowButton" Content="Check now" Margin="0,0,8,0" Click="OnCheckNow" />
                            <Button x:Name="ReleasesButton" Content="Open the releases page" Click="OnOpenReleases" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,8,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="What this is" Margin="0,0,0,4" />
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="RingPanel" Grid.Row="1" Grid.Column="1" Margin="10" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Preview" />
                    <Border Background="Black" Width="340" Height="340" HorizontalAlignment="Left">
                        <Image x:Name="PreviewImage" Width="340" Height="340" Stretch="None" />
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,8"
                               Text="Approximate: about what a cropped 1080p stream shows. The real ring scales with your OBS source's size and crop." />

                    <UniformGrid Columns="4" Margin="0,0,0,6">
                        <RadioButton x:Name="BgCockpit" Content="Cockpit" IsChecked="True" MinWidth="0" Checked="OnPreviewOptionChanged" />
                        <RadioButton x:Name="BgTerrain" Content="Terrain" MinWidth="0" Checked="OnPreviewOptionChanged" />
                        <RadioButton x:Name="BgSky" Content="Sky" MinWidth="0" Checked="OnPreviewOptionChanged" />
                        <RadioButton x:Name="BgBlack" Content="Black" MinWidth="0" Checked="OnPreviewOptionChanged" />
                    </UniformGrid>
                    <CheckBox x:Name="PreviewMoving" Content="Show while the eyes are moving (tail)" Checked="OnPreviewOptionChanged" Unchecked="OnPreviewOptionChanged" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Presets" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Starting points for the look. They leave motion and placement alone." />
                    <WrapPanel x:Name="PresetButtons" />
                    <Button Content="Reset everything to defaults" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetAll" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Saving" Margin="0,20,0,4" />
                    <TextBlock x:Name="SaveStatus" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open settings file" Margin="0,0,8,0" Click="OnOpenConfig" />
                        <Button Content="Reload from file" Click="OnReloadConfig" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
