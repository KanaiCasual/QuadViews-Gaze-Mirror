<Window x:Class="GazeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuadViews Gaze Mirror" Width="900" Height="640" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontSize="13" UseLayoutRounding="True"
        Background="{StaticResource WindowBack}" Icon="Assets/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Shown when a newer release exists. It only links to the release page; nothing is downloaded by the app. -->
        <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="10,10,10,0" Padding="14,10"
                Background="#16283A" BorderBrush="#2F6FA8" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateDetail" Style="{StaticResource Hint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="View release" FontWeight="SemiBold" Margin="12,0,8,0" Click="OnViewUpdate" />
                    <Button Content="Skip this version" Margin="0,0,8,0" Click="OnSkipUpdate" />
                    <Button Content="Later" Click="OnDismissUpdate" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs and the preview share this inner grid, so nothing else can influence the preview column's width. -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PreviewColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <TabControl x:Name="Tabs" Grid.Column="0" Margin="8,8,0,0" Padding="0">
            <TabItem Header="Status" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10,14,12">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,2">
                            <StackPanel x:Name="StatusRows" />
                        </Border>

                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Refresh" VerticalAlignment="Top" Margin="8,0,0,0" Click="OnRefresh" />
                            <Ellipse x:Name="LiveDot" DockPanel.Dock="Left" Width="10" Height="10" Margin="2,5,8,0" VerticalAlignment="Top" Fill="Gray" />
                            <TextBlock x:Name="LiveText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="OpenXR API layers" Margin="0,14,0,2" />
                        <TextBlock x:Name="LayerHint" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,6"
                                   Text="In the order games load them - top is closest to the game. Tick boxes switch a layer on or off, the arrows reorder (Windows asks for permission)." />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,2">
                            <StackPanel x:Name="LayerRows" />
                        </Border>
                        <TextBlock x:Name="LayerProblems" Foreground="Orange" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="LayerFix" Content="Fix order" FontWeight="SemiBold" Margin="0,0,6,0" Visibility="Collapsed" Click="OnLayerFixOrder" />
                            <Button x:Name="LayerApply" Content="Apply order" FontWeight="SemiBold" Margin="0,0,6,0" Visibility="Collapsed" Click="OnLayerApplyOrder" />
                            <Button x:Name="LayerCancel" Content="Cancel" Visibility="Collapsed" Click="OnLayerCancelOrder" />
                        </WrapPanel>
                        <TextBlock x:Name="LayerNote" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,12,0,0"
                                   Text="In OBS: add a &quot;Gaze Mirror&quot; source (Ctrl+F once to fit it). Eye, crop and ring are set on the Mirror tab; the ring only appears while a game runs with eye tracking active." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Look" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelLook" Margin="14,10,14,12" /></ScrollViewer></TabItem>
            <TabItem Header="Tail" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelTail" Margin="14,10,14,12" /></ScrollViewer></TabItem>
            <TabItem Header="Motion" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelMotion" Margin="14,10,14,12" /></ScrollViewer></TabItem>
            <TabItem Header="Placement" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelPlacement" Margin="14,10,14,12" /></ScrollViewer></TabItem>

            <TabItem x:Name="CropTab" Header="Mirror" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}">
                <!-- The picture takes whatever height is left; in a small window it keeps a usable size and the tab scrolls instead. -->
                <ScrollViewer x:Name="MirrorScroll" VerticalScrollBarVisibility="Auto">
                <DockPanel Margin="14,10,14,8" MinHeight="{Binding ViewportHeight, ElementName=MirrorScroll, Converter={StaticResource LessMargin}}">
                    <!-- The mirror window: a capturable window with the mirror picture (OBS Window Capture, Discord, ...). -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,4,10,6" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Mirror window" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                           ToolTip="A window that shows the mirror picture - cropped, with the ring - so that anything which can capture a window can use it: OBS Window Capture, Discord, ... No OBS plugin needed. It normally fills a monitor BEHIND your game and never comes to the front." />
                                <Button x:Name="MirrorOpen" Content="Open" FontWeight="SemiBold" Margin="0,2,6,2" Click="OnMirrorOpen" />
                                <Button x:Name="MirrorClose" Content="Close" Margin="0,2,12,2" Click="OnMirrorClose" />
                                <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Show on" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="MirrorPlacement" MinWidth="250" Margin="0,2,12,2" VerticalAlignment="Center"
                                          ToolTip="Filling a monitor gives capture tools the full resolution of that monitor. The window stays behind every other window there." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Size" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="MirrorSize" MinWidth="150" Margin="0,2,12,2" VerticalAlignment="Center"
                                          ToolTip="How many pixels the mirror window's picture has - that is what OBS or Discord get. Smaller costs less graphics card time. With a size chosen, the window sits in the monitor's top left corner (behind everything) instead of covering the monitor." />
                                <StackPanel x:Name="MirrorCustomSize" Orientation="Horizontal" Visibility="Collapsed" Margin="-6,0,12,0">
                                    <TextBox x:Name="MirrorCustomWidth" Width="64" MinWidth="0" Margin="0,2,4,2" VerticalAlignment="Center" ToolTip="Width in pixels (64 - 16384). Press Enter to apply." />
                                    <TextBlock Text="x" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox x:Name="MirrorCustomHeight" Width="64" MinWidth="0" Margin="0,2,0,2" VerticalAlignment="Center" ToolTip="Height in pixels (64 - 16384). Press Enter to apply." />
                                </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rate" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="MirrorRate" MinWidth="100" Margin="0,2,0,2" VerticalAlignment="Center"
                                          ToolTip="The mirror window draws at most this many pictures a second, however fast the game runs. 30 halves its cost again - fine for Discord." />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="MirrorTitled" Content="Keep a title bar" MinWidth="0" Margin="0,0,16,0"
                                          ToolTip="Only when filling a monitor: keep a title bar (pushed off the top of the monitor). Try it if a capture tool does not list the window." />
                                <TextBlock x:Name="MirrorStatus" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- The picture itself: what every reader (OBS source, mirror window) gets, and where it comes from. -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,4,10,6" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <UniformGrid x:Name="PanelOutput" Columns="1" />
                            <TextBlock x:Name="MirrorSource" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="SteamVR games" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                           ToolTip="Games that use SteamVR directly (OpenVR) instead of OpenXR never load the mirror layer. A small helper program next to SteamVR mirrors them instead - same crop, same ring." />
                                <TextBlock x:Name="HelperStatus" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Crop profiles: saved framings, each optionally applied when a given game starts. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                        <TextBlock Text="Profile" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip="A saved framing (crop box, follow, steadying). One with a game name is applied by the mirror whenever that game starts." />
                        <ComboBox x:Name="CropProfile" MinWidth="220" Margin="0,2,6,2" VerticalAlignment="Center" DisplayMemberPath="Label" />
                        <Button x:Name="CropProfileSaveAs" Content="Save as..." ToolTip="Save the current framing as a profile" Margin="0,2,6,2" Click="OnProfileSaveAs" />
                        <StackPanel x:Name="CropProfileNamePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                            <TextBox x:Name="CropProfileName" Width="140" MinWidth="0" Margin="0,2,4,2" VerticalAlignment="Center" ToolTip="Name of the profile. Enter saves, Esc cancels." />
                            <Button Content="OK" Margin="0,2,0,2" Click="OnProfileSaveConfirm" />
                        </StackPanel>
                        <Button x:Name="CropProfileDelete" Content="Delete" Margin="0,2,12,2" Click="OnProfileDelete" />
                        <TextBlock Text="For game" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="CropProfileGame" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MinWidth="220" MaxDropDownHeight="240"
                                  DisplayMemberPath="Label" TextSearch.TextPath="Exe" Margin="0,2,6,2" VerticalAlignment="Center"
                                  ToolTip="The game's program file, for example DCS.exe or VRChat.exe. Open the list to pick a running program, or type - the list narrows as you type. Enter applies. Empty = the profile is only applied when chosen here." />
                    </WrapPanel>
                    <TextBlock x:Name="CropProfileStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <WrapPanel DockPanel.Dock="Top">
                        <CheckBox x:Name="CropEnabled" Content="Crop the mirror image" FontWeight="SemiBold" MinWidth="0" Margin="0,0,14,0" VerticalAlignment="Center"
                                  ToolTip="Hand OBS only the box instead of the whole eye image" />
                        <TextBlock Text="Shape" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="CropAspect" MinWidth="150" Margin="0,2,10,2" VerticalAlignment="Center" />
                        <Button x:Name="CropCentreButton" Content="Centre" ToolTip="Put the box in the middle of the image" Margin="0,2,6,2" Click="OnCropCentre" />
                        <Button x:Name="CropLargestButton" Content="Largest" ToolTip="Make the box as large as the image allows" Margin="0,2,6,2" Click="OnCropFill" />
                        <CheckBox x:Name="CropLocked" Content="Lock box" MinWidth="0" Margin="4,0,10,0" VerticalAlignment="Center"
                                  ToolTip="Locked: the box cannot be moved or resized with the mouse, so a stray click or scroll changes nothing" />
                        <Button x:Name="CropRefresh" Content="Refresh picture" ToolTip="Ask the running game for a new picture of the mirror image, right now" Margin="0,2,6,2" Click="OnCropRefresh" />
                        <Button x:Name="CropCapture" Content="Capture from headset" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}" Margin="0,2,2,2" Click="OnCaptureArm"
                                ToolTip="Take the picture from inside the headset instead of from the desk: arm this, put the headset on, sit the way you play, look straight ahead and press the key. It takes one picture of each eye and switches itself off again. The picture is kept until you press Refresh picture." />
                        <Button x:Name="CropCaptureKey" Content="Key: Pause" Margin="0,2,10,2" Click="OnCaptureKeyClick"
                                ToolTip="The key that takes the picture while a capture is armed (it does nothing otherwise). Click, then press the key you want; Esc keeps the current one. The game sees the key too, so choose one that does no harm there (Pause only pauses most sims)." />
                        <ComboBox x:Name="CropPictureEye" MinWidth="140" Margin="0,2,10,2" VerticalAlignment="Center" Visibility="Collapsed"
                                  ToolTip="Which eye's picture is shown behind the box. The box itself is the same for both eyes." />
                    </WrapPanel>
                    <!-- Capture from the headset, armed: impossible to miss, and says what to do. -->
                    <Border x:Name="CaptureBanner" DockPanel.Dock="Top" Margin="0,6,0,0" Padding="14,10" Visibility="Collapsed"
                            Background="#3A2A0C" BorderBrush="#E09A2B" BorderThickness="2" CornerRadius="6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnCaptureCancel" />
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#FFC35A" Text="CAPTURE ARMED - waiting for the key" />
                                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">
                                    <Run Text="1. Put the headset on.  2. Sit the way you play and look straight ahead.  3. Press" />
                                    <Run x:Name="CaptureBannerKey" FontWeight="Bold" Foreground="#FFC35A" Text="Pause" /><Run Text=".  A sound tells you the picture was taken; this then switches itself off." />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="CropReadout" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="CropStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap" />
                    <!-- The two fold-away sections sit side by side when there is room (set in code). -->
                    <UniformGrid x:Name="MirrorSections" DockPanel.Dock="Top" Columns="1">
                    <Expander x:Name="CropFollowExpander" Header="Follow my gaze (up / down)" Margin="0,0,0,6" VerticalAlignment="Top">
                        <!-- Two columns when there is room (set in code), so the settings take little height from the picture. -->
                        <UniformGrid x:Name="PanelCropFollow" Columns="1" Margin="0,4,0,0" />
                    </Expander>
                    <Expander x:Name="StabilizeExpander" Header="Steady the picture (head movement)" Margin="0,0,0,6" VerticalAlignment="Top">
                        <UniformGrid x:Name="PanelStabilize" Columns="1" Margin="0,4,0,0" />
                    </Expander>
                    </UniformGrid>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0"
                               Text="Drag inside the box to move it; drag a corner or use the mouse wheel over it to resize. In OBS: set the crop values in the source's Properties to 0, then select the source and press Ctrl+F (Transform > Fit to screen) once - after that it keeps fitting when the box changes size."
                               ToolTip="Fit to screen gives the source a bounding box the size of your canvas (in Edit Transform: Bounds = Scale to inner bounds). The gaze ring and the calibration are not affected by the crop: they are drawn on the whole image first." />
                    <Border x:Name="CropFrameBorder" Background="#0B0C0E" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" MinHeight="240">
                        <Canvas x:Name="CropCanvas" Background="Transparent" ClipToBounds="True" />
                    </Border>
                </DockPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="QuadViewsTab" Header="Quad Views" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}">
                <DockPanel>
                    <!-- Stays in view while the sliders scroll: what the settings cost, Apply, and the presets. -->
                    <Border DockPanel.Dock="Top" Margin="14,10,14,0" Padding="12,8" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="QuadViewsLoadLast" Foreground="Orange" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock x:Name="QuadViewsLoadSaved" TextWrapping="Wrap" Margin="0,1,0,0" />
                            <TextBlock x:Name="QuadViewsLoadNext" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,1,0,0" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="QuadViewsApply" Content="Apply" FontWeight="SemiBold" MinWidth="76" Margin="0,2,6,2" Click="OnQuadViewsApply" />
                                <Button x:Name="QuadViewsRevert" Content="Revert" Margin="0,2,14,2" Click="OnQuadViewsRevert" />
                                <TextBlock Text="Presets" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <WrapPanel x:Name="QuadViewsPresets" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <WrapPanel x:Name="QuadViewsSlots" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button Content="File" ToolTip="Open Quad-Views-Foveated's settings file" Margin="0,2,6,2" Click="OnQuadViewsOpenFile" />
                                <Button Content="Log" ToolTip="Open Quad-Views-Foveated's log" Margin="0,2,0,2" Click="OnQuadViewsOpenLog" />
                            </WrapPanel>
                            <TextBlock x:Name="QuadViewsStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuadViewsNotice" DockPanel.Dock="Top" Margin="14,8,14,0" Padding="12,6"
                            Background="#33270F" BorderBrush="#A8741F" BorderThickness="1" CornerRadius="6">
                        <TextBlock x:Name="QuadViewsNoticeText" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelQuadViews" Margin="14,10,14,12" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="About" Padding="4,4" HeaderTemplate="{StaticResource SmallTabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10,14,12">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="About" />
                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" Margin="0,6,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="The app can look at the project's GitHub releases when it opens and tell you when a newer version exists. It only reads that public list - it never downloads or installs anything. You get a link to the release page and install the new .msi yourself." />
                        <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates when the app opens" Checked="OnUpdatePreferenceChanged" Unchecked="OnUpdatePreferenceChanged" />
                        <CheckBox x:Name="IncludeBetasBox" Content="Also tell me about beta versions" Margin="0,4,0,0" Checked="OnUpdatePreferenceChanged" Unchecked="OnUpdatePreferenceChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CheckNowButton" Content="Check now" Margin="0,0,8,0" Click="OnCheckNow" />
                            <Button x:Name="ReleasesButton" Content="Open the releases page" Click="OnOpenReleases" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,8,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="What this is" Margin="0,0,0,4" />
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- The ring preview. Hidden on narrow windows and with the Preview switch below, so the app can sit beside a game. -->
        <Border x:Name="RingPanel" Grid.Column="1" Margin="8,8,8,0" Padding="10" VerticalAlignment="Top" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
            <StackPanel Width="260">
                <Border Background="Black" Width="260" Height="260">
                    <Image x:Name="PreviewImage" Width="260" Height="260" Stretch="None"
                           ToolTip="Approximate: about what a cropped 1080p stream shows. The real ring scales with your OBS source's size and crop." />
                </Border>
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <RadioButton x:Name="BgCockpit" Content="Cockpit" IsChecked="True" MinWidth="0" Checked="OnPreviewOptionChanged" />
                    <RadioButton x:Name="BgTerrain" Content="Terrain" MinWidth="0" Checked="OnPreviewOptionChanged" />
                    <RadioButton x:Name="BgSky" Content="Sky" MinWidth="0" Checked="OnPreviewOptionChanged" />
                    <RadioButton x:Name="BgBlack" Content="Black" MinWidth="0" Checked="OnPreviewOptionChanged" />
                </UniformGrid>
                <CheckBox x:Name="PreviewMoving" Content="Eyes moving (tail)" Checked="OnPreviewOptionChanged" Unchecked="OnPreviewOptionChanged" />
            </StackPanel>
        </Border>

        </Grid>

        <!-- Ring settings save by themselves; this says when, and whether a running game took them. -->
        <Grid x:Name="BottomBar" Grid.Row="2" Margin="10,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource Hint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="PreviewToggle" Content="Preview" IsChecked="True" MinWidth="0" Margin="8,0,8,0" Checked="OnLayoutOptionChanged" Unchecked="OnLayoutOptionChanged" />
                <Button Content="File" ToolTip="Open the ring's settings file" Margin="0,0,6,0" Click="OnOpenConfig" />
                <Button Content="Reload" ToolTip="Read the ring's settings file again" Click="OnReloadConfig" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
