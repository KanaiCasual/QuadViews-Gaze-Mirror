# This folder also holds unrelated projects, so this is a WHITELIST: everything at the top level is ignored unless it is
# named below. Add new top-level files/folders here deliberately.
/*

!/.gitignore
!/.gitmodules
!/README.md
!/CHANGELOG.md
!/LICENSE
!/docs/
!/Build-Layers.ps1
!/Build-Installer.ps1
!/gaze.cfg
!/GazeOverlayApp/
!/Installer/
!/MirrorWindow/
!/Build-MirrorWindow.ps1
!/patches/
!/tools/
# 2.0: the new layer, OBS plugin, OpenVR helper, shared core, tests (see v2\README.md).
!/v2/
# Upstream sources, as submodules pinned to the commits our patches apply to.
!/Quad-Views-Foveated
!/OpenXR-Layer-OBSMirror

# Build output and anything binary/generated.
bin/
obj/
*.user
# The installer payload is collected from build outputs (and the upstream OBS plugin) by Collect-Payload.ps1.
/GazeOverlayApp/Payload/
# Recordings reviewed with tools/clip-review.
/tools/clip-review/*.mp4
__pycache__/
# 2.0 downloaded third-party files are fetched by v2\Get-External.ps1, only their licences are kept.
/v2/external/libobs/*
!/v2/external/libobs/COPYING
!/v2/external/libobs/obsconfig.h
/v2/external/libobs-lib/
/v2/external/openvr/*
!/v2/external/openvr/LICENSE
/v2/external/qvf/
/v2/external/vrcft/*
!/v2/external/vrcft/LICENSE
/v2/bin/
/v2/obj/
